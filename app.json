{
  "expo": {
    "name": "Kirshner Farm",
    "slug": "kirshner-farm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kirshnerfarm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.kirshnerfarm.app"
    },
    "android": {
      "package": "com.kirshnerfarm.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "windowSoftInputMode": "adjustResize",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#245C38",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to upload product images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "https://gcihfcmnroxlxwuakvbm.supabase.co",
      "supabaseAnonKey": "sb_publishable_-KWcVjJbR4TdX1hWVmkU1A_CLv3B7oU",
      "router": {},
      "eas": {
        "projectId": "a85f27c8-8464-4dc3-a1fd-e4abb71e2409"
      }
    },
    "owner": "nobin23t"
  }
}
