{
  "expo": {
    "name": "grocery-store-hebrew",
    "slug": "grocery-store-hebrew",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icons/appstore.png",
    "scheme": "grocerystorehebrew",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icons/appstore.png",
      "bundleIdentifier": "com.meshakkirshner.grocery"
    },
    "android": {
      "package": "com.meshakkirshner.grocery",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/app-icons/playstore.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to upload product images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
